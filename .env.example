# Every environment variable this project uses, with dummy values. Copy to
# .env (gitignored) and fill in real values there; never in this file.
# docs/configuration.md says what each one does.

# --- The laser controller --------------------------------------------------

# The Ruida controller's IP address or host name (required).
RUIDA_HOST=192.0.2.50

# UDP port the controller listens on.
# RUIDA_PORT=50200

# UDP port the controller sends its replies to, on this host. Only one
# program per host can use it: not LightBurn/RDWorks on the same machine.
# RUIDA_LOCAL_PORT=40200

# Byte-scrambling key: 0x88 for RDC644x/654x/633x/320 boards, 0x11 for 634XG.
# RUIDA_MAGIC=0x88

# Seconds to wait for each reply, and how many times to resend.
# RUIDA_TIMEOUT=1.0
# RUIDA_RETRIES=2

# Seconds between polls of status and position, and between reads of the
# lifetime counters and settings.
# POLL_INTERVAL=2
# SLOW_POLL_INTERVAL=300

# --- MQTT ------------------------------------------------------------------

# The broker. Leave unset to run without MQTT (HTTP /status only).
MQTT_HOST=mqtt.example.com
# MQTT_PORT=1883
# MQTT_USERNAME=laser-cutterd
# MQTT_PASSWORD=REPLACE_ME
# Connect with TLS (verifying the broker's certificate). Usually with port 8883.
# MQTT_TLS=false
# Defaults to laser-cutterd-<DEVICE_ID>.
# MQTT_CLIENT_ID=laser-cutterd-laser_cutter
# Topics are <MQTT_TOPIC_PREFIX>/<DEVICE_ID>/state and so on.
# MQTT_TOPIC_PREFIX=laser-cutterd

# --- Home Assistant --------------------------------------------------------

# Publish MQTT discovery so Home Assistant creates the device by itself.
# HA_DISCOVERY=true
# HA_DISCOVERY_PREFIX=homeassistant

# How the laser appears in Home Assistant. DEVICE_ID: lowercase letters,
# digits and underscores; it's in every topic and entity id.
# DEVICE_ID=laser_cutter
# DEVICE_NAME=Laser Cutter
# DEVICE_MANUFACTURER=Redsail
# DEVICE_MODEL=X700

# --- The daemon ------------------------------------------------------------

# Address and port for GET /healthz and /status. The Docker image sets
# HOST=0.0.0.0; natively the default, 127.0.0.1, keeps it private.
# HOST=127.0.0.1
# PORT=8000

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
LOG_LEVEL=INFO
